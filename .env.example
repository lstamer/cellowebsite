# Required for contact (/api/contact) and booking (/api/leads) forms
ATTIO_API_KEY=

# Alias accepted by the API routes
# ATTIO_CRM_KEY=

# Optional — venue autocomplete on /book
NEXT_PUBLIC_GOOGLEMAPS_JS_API_KEY=

# Optional — public WhatsApp number for the site's "WhatsApp me" links (E.164
# digits, no '+'). Falls back to 27639081386 if unset.
# NEXT_PUBLIC_WHATSAPP_NUMBER=27639081386

# Optional — WhatsApp alert when a booking lead is submitted
# WASENDER_API_KEY=
# WASENDER_NOTIFY_TO=+27xxxxxxxxxx

# Inbound WhatsApp inquiry automation — Supabase operational data layer
SUPABASE_URL=
# Prefer Supabase's new sb_secret_... key. The legacy service_role key is also
# accepted through SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Trigger.dev orchestration
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Vercel AI Gateway (used by Trigger.dev, where Vercel OIDC is unavailable)
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.4-mini

# Zernio WhatsApp transport
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Telegram human approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram numeric user IDs allowed to approve or reject
TELEGRAM_APPROVER_USER_IDS=
# 1-256 characters using only A-Z, a-z, 0-9, underscore and hyphen
TELEGRAM_WEBHOOK_SECRET=
