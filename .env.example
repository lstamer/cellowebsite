# Required for contact (/api/contact) and booking (/api/leads) forms
ATTIO_API_KEY=

# Alias accepted by the API routes
# ATTIO_CRM_KEY=

# Optional — venue autocomplete on /book
NEXT_PUBLIC_GOOGLEMAPS_JS_API_KEY=

# Optional — public WhatsApp number for the site's "WhatsApp me" links (E.164
# digits, no '+'). Falls back to 27639081386 if unset.
# NEXT_PUBLIC_WHATSAPP_NUMBER=27639081386

# Optional — WhatsApp alert when a booking lead is submitted
# WASENDER_API_KEY=
# WASENDER_NOTIFY_TO=+27xxxxxxxxxx

# Inbound WhatsApp inquiry automation — Supabase operational data layer
SUPABASE_URL=
# Prefer Supabase's new sb_secret_... key. The legacy service_role key is also
# accepted through SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Trigger.dev orchestration
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Vercel AI Gateway (used by Trigger.dev, where Vercel OIDC is unavailable)
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.4-mini
# Optional failover for recoverable AI Gateway outages and quota responses.
# Both variables are required before text generation retries through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional — speech-to-text for the "Suggest changes" voicenotes Luke sends the
# Telegram bot. Routed through the primary Vercel AI Gateway. Defaults to
# openai/whisper-1 when unset.
# AI_TRANSCRIBE_MODEL=openai/whisper-1
# Optional OpenRouter speech-to-text failover. This is used only after a
# recoverable AI Gateway transcription error. Confirm the model remains
# available in your OpenRouter account before setting it.
# OPENROUTER_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe

# LangSmith tracing for the inquiry agent — entirely optional. Leave
# LANGSMITH_TRACING unset (or anything other than "true") and no traces are
# sent and nothing in the reply pipeline changes.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# Project that production inquiry traces land in. Default: stamer-inquiry-agent
# LANGSMITH_PROJECT=stamer-inquiry-agent
# Separate project for `npm run eval`. Default: stamer-inquiry-agent-evals
# LANGSMITH_EVAL_PROJECT=stamer-inquiry-agent-evals
# Only for self-hosted or EU LangSmith, e.g. https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# Zernio WhatsApp transport
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Telegram human approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram numeric user IDs allowed to approve or reject
TELEGRAM_APPROVER_USER_IDS=
# 1-256 characters using only A-Z, a-z, 0-9, underscore and hyphen
TELEGRAM_WEBHOOK_SECRET=
